---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/TomyCesaille/gitlab-live-refresh';
const userscript = `${repo}/releases/latest/download/gitlab-live-refresh.user.js`;

const trace = `localStorage.setItem('gl-live-refresh:debug', '1')
// then, on any GitLab page of the site:
JSON.parse(localStorage.getItem('gl-live-refresh:trace')).join('\\n')`;
---

<Layout>
  <a
    class="github-corner"
    href="https://github.com/TomyCesaille/gitlab-live-refresh"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="View source on GitHub"
  >
    <svg width="80" height="80" viewBox="0 0 250 250" aria-hidden="true">
      <path d="M0,0 L115,115 L130,115 L142,142 L250,250 L250,0 Z" class="corner-bg"></path>
      <path
        d="M128.3,109.0 C113.8,99.7 119.0,89.6 119.0,89.6 C122.0,82.7 120.5,78.6 120.5,78.6 C119.2,72.0 123.4,76.3 123.4,76.3 C127.3,80.9 125.5,87.3 125.5,87.3 C122.9,97.6 130.6,101.9 134.4,103.2"
        fill="currentColor"
        style="transform-origin: 130px 106px;"
        class="octo-arm"
      ></path>
      <path
        d="M115.0,115.0 C114.9,115.1 118.7,116.5 119.8,115.4 L133.7,101.6 C136.9,99.2 139.9,98.4 142.2,98.6 C133.8,88.0 127.5,74.4 143.8,58.0 C148.5,53.4 154.0,51.2 159.7,51.0 C160.3,49.4 163.2,43.6 171.4,40.1 C171.4,40.1 176.1,42.5 178.8,56.2 C183.1,58.6 187.2,61.8 190.9,65.4 C194.5,69.1 197.7,73.2 200.1,77.6 C213.8,80.2 216.3,84.9 216.3,84.9 C212.7,93.1 206.9,96.0 205.4,96.6 C205.1,102.4 203.0,107.8 198.3,112.5 C181.9,128.9 168.3,122.5 157.7,114.1 C157.9,116.9 156.7,120.9 152.7,124.9 L141.0,136.5 C139.8,137.7 141.6,141.9 141.8,141.8 Z"
        fill="currentColor"
      ></path>
    </svg>
  </a>

  <header class="header">
    <span class="logo"><img src={`${base}/favicon.svg`} width="28" height="28" alt="" />gitlab-live-refresh</span>
    <ThemeToggle />
  </header>

  <section class="hero section">
    <h1>The reload button for GitLab, pressed for you.</h1>
    <p class="subtitle">Merge request, pipeline and job pages reload themselves when something changes, never while you type. For Chrome, Firefox and userscript managers.</p>
    <div class="badges">
      <img src="https://img.shields.io/badge/Chrome-MV3-4285F4?logo=googlechrome&logoColor=fff" height="20" alt="Chrome, Manifest V3" />
      <img src="https://img.shields.io/badge/Firefox-MV3-FF7139?logo=firefoxbrowser&logoColor=fff" height="20" alt="Firefox, Manifest V3" />
      <img src="https://img.shields.io/badge/coverage-100%25-brightgreen" height="20" alt="100% test coverage" />
      <a href={`${repo}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer" aria-label="MIT license">
        <img src="https://img.shields.io/github/license/TomyCesaille/gitlab-live-refresh" height="20" alt="license" />
      </a>
      <a href={`${repo}/actions/workflows/ci.yml`} target="_blank" rel="noopener noreferrer" aria-label="CI runs">
        <img src="https://img.shields.io/github/actions/workflow/status/TomyCesaille/gitlab-live-refresh/ci.yml?branch=main" height="20" alt="CI" />
      </a>
    </div>
  </section>

  <figure class="demo section">
    <img
      src={`${base}/banner.png`}
      width="1120"
      height="480"
      alt="Two banners in a page's top right corner. Blue: GitLab changed: pipeline, comments. Reload waits: you are typing. Orange: GitLab error on this page. Reload waits: text is selected. Each has a Reload button and a dismiss cross."
    />
    <figcaption>When a reload has to wait on you, a banner says what changed and what it waits for.</figcaption>
  </figure>

  <section class="install section">
    <h2>Why</h2>
    <p>GitLab's pages are meant to update themselves. Often they do not: a pipeline still reads <code>running</code> long after it passed, a merge request misses the comment that just landed, and you reload to find out. GitLab Live Refresh asks GitLab what changed and reloads the page for you, at a moment that costs you nothing.</p>
  </section>

  <section class="install section">
    <h2>When it reloads</h2>
    <ul class="rules">
      <li>When something you would reload for changed: a pipeline or job status, commits, a comment, approvals, the merge status, the state of the merge request.</li>
      <li>Never while you type, while a draft is on screen, while text is selected or while a menu or dialog is open. It waits until you have been idle for 8 seconds.</li>
      <li>Edits wait for the page to settle: a bot rewriting its comment three times in a row costs one reload, 30 seconds after the last edit.</li>
      <li>Automatic reloads are 45 seconds apart, 3 minutes in a background tab, so a push and its pipeline cost one or two reloads.</li>
      <li>Coming back to a tab reloads it at once when something changed, before you start reading.</li>
      <li>You land where you were: GitLab scrolls inside a panel the browser does not restore.</li>
      <li>A page showing &ldquo;Something went wrong&rdquo; reloads too, at most 3 times until you reload it yourself.</li>
    </ul>
  </section>

  <section class="install section">
    <h2>Install the extension</h2>
    <p>Download the Chrome or Firefox build from the <a href={`${repo}/releases/latest`}>latest release</a>. In Chrome, unzip it, open <code>chrome://extensions</code>, turn on Developer mode and choose Load unpacked.</p>
    <p>Then open a GitLab page, click the extension&rsquo;s icon and turn live refresh on for that site. It asks for that one site, nothing more.</p>
  </section>

  <section class="install section">
    <h2>Or the userscript</h2>
    <p>With <a href="https://violentmonkey.github.io/">Violentmonkey</a> or Tampermonkey installed, open <a href={userscript}>gitlab-live-refresh.user.js</a>. It runs on the merge request, pipeline and job pages of any GitLab host, with no setup, and updates itself from the latest release.</p>
    <p>One limit: Chrome freezes background tabs, and nothing inside a page runs while it is frozen. The userscript catches up the moment you come back to the tab; the extension keeps background tabs current.</p>
  </section>

  <section class="install section">
    <h2>See what it does</h2>
    <p>The debug trace logs every check, wait and reload of every tab of the site, and survives reloads. In the console:</p>
    <pre><code>{trace}</code></pre>
  </section>

  <footer class="footer">
    <a href={repo}>GitHub</a>
    <span class="separator">&middot;</span>
    <a href={`${repo}#readme`}>README</a>
    <span class="separator">&middot;</span>
    Built by <a href="https://jorislacance.fr">jorislacance.fr</a>
    <p class="disclaimer">Not affiliated with GitLab Inc.</p>
  </footer>
</Layout>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2xl);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
  }

  .section {
    margin-bottom: var(--space-2xl);
  }

  .hero h1 {
    font-size: 32px;
    font-weight: 700;
    font-family: var(--font-mono);
    line-height: 1.1;
  }

  .hero .subtitle {
    color: var(--text-muted);
    margin-top: var(--space-sm);
  }

  .badges {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .install h2 {
    font-size: 20px;
    font-weight: 700;
    font-family: var(--font-mono);
    margin-bottom: var(--space-md);
  }




  .install p code,
  .rules code {
    font-family: var(--font-mono);
    font-size: 14px;
    background: var(--code-bg);
    padding: 2px 6px;
    border-radius: 3px;
  }


  .demo {
    width: min(1080px, calc(100vw - 2 * var(--space-md)));
    margin-left: 50%;
    transform: translateX(-50%);
    text-align: center;
  }

  .demo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .demo figcaption {
    color: var(--text-muted);
    font-size: 14px;
    margin-top: var(--space-sm);
  }

  .demo figcaption code {
    font-family: var(--font-mono);
  }

  .install p {
    margin-bottom: var(--space-md);
  }

  .install p:last-child {
    margin-bottom: 0;
  }

  .install pre {
    background: var(--code-bg);
    padding: var(--space-md);
    border-radius: 4px;
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 14px;
    overflow-x: auto;
      margin-bottom: var(--space-md);
  }

  .footer {
    text-align: center;
    color: var(--text-muted);
    font-size: 14px;
    padding-top: var(--space-xl);
  }

  .footer a {
    color: var(--accent);
  }

  .rules {
    padding-left: var(--space-lg);
  }

  .rules li {
    margin-bottom: var(--space-sm);
  }

  .footer .disclaimer {
    margin-top: var(--space-sm);
  }

  .footer .separator {
    margin: 0 var(--space-sm);
  }

  .github-corner {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 10;
    color: var(--bg);
    line-height: 0;
  }

  .github-corner .corner-bg {
    fill: var(--accent);
  }

  .github-corner svg {
    display: block;
    transition: transform 200ms ease;
  }

  .github-corner:hover svg {
    transform: scale(1.05);
  }

  .github-corner:hover .octo-arm {
    animation: octocat-wave 560ms ease-in-out;
  }

  @keyframes octocat-wave {
    0%, 100% { transform: rotate(0); }
    20%, 60% { transform: rotate(-25deg); }
    40%, 80% { transform: rotate(10deg); }
  }

  /* Below 672px the page-wrapper (max-width: 640px) hits viewport edges,
     pushing the theme toggle flush right. Shrink the corner so its bottom
     edge stays clear of the toggle's click target. */
  @media (max-width: 672px) {
    .github-corner svg {
      width: 60px;
      height: 60px;
    }
  }

  @media (max-width: 500px) {
    .github-corner:hover .octo-arm {
      animation: none;
    }
    .github-corner .octo-arm {
      animation: octocat-wave 560ms ease-in-out;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .github-corner svg,
    .github-corner .octo-arm {
      transition: none;
      animation: none;
    }
  }
</style>
